# This tracked file is a template. Put machine-specific values in sagnex.env.
# Paths are resolved from the repository root.
SAGNEX_DATA_DIR=./data
SAGNEX_BACKUP_DIR=./data/backups

# Optional server-side email login. Leave SAGNEX_AUTH_EMAIL blank to disable login.
SAGNEX_AUTH_EMAIL=
SAGNEX_SMTP_HOST=
SAGNEX_SMTP_PORT=587
SAGNEX_SMTP_USER=
SAGNEX_SMTP_PASSWORD=
SAGNEX_SMTP_FROM=
SAGNEX_SESSION_IDLE_DAYS=14
SAGNEX_SESSION_MAX_DAYS=30

# Public domain name or IPv4 address, without https://, port, or path.
SAGNEX_PUBLIC_HOST=sagnex.example.com
SAGNEX_CADDY_BIND_ADDRESS=0.0.0.0
SAGNEX_CADDY_HTTP_PORT=80
SAGNEX_CADDY_HTTPS_PORT=443
SAGNEX_CADDY_DATA_DIR=./data/caddy
SAGNEX_CADDY_CONFIG_DIR=./data/caddy-config

# Leave blank to use the current Ubuntu user through sagnex.sh.
SAGNEX_DOCKER_USER=

# Docker build download sources. The APT mirror must support HTTP because the
# slim base image installs CA certificates from it. Official alternatives are
# http://deb.debian.org and https://registry.npmjs.org.
SAGNEX_APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
SAGNEX_NPM_REGISTRY=https://registry.npmmirror.com
