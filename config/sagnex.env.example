# This tracked file is a template. Put machine-specific values in sagnex.env.
# Paths are resolved from the repository root.
SAGNEX_DATA_DIR=./data
SAGNEX_BACKUP_DIR=./data/backups

# Web access. Keep 127.0.0.1 unless LAN access is intentional.
SAGNEX_BIND_ADDRESS=127.0.0.1
SAGNEX_WEB_PORT=4173
SAGNEX_API_PORT=4784

# Leave blank to use the current Ubuntu user through sagnex.sh.
SAGNEX_DOCKER_USER=

# Docker build download sources. Official alternatives are https://deb.debian.org
# and https://registry.npmjs.org.
SAGNEX_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
SAGNEX_NPM_REGISTRY=https://registry.npmmirror.com
